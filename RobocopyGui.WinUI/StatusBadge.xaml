<UserControl
    x:Class="RobocopyGui.WinUI.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Pill" Height="24" Padding="8,0,10,0" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Tones">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Attention">
                    <VisualState.Setters>
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Accent">
                    <VisualState.Setters>
                        <Setter Target="Icon.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                        <Setter Target="Pill.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter Target="Pill.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                        <Setter Target="Pill.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
            <FontIcon x:Name="Icon" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="Label" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </Border>
</UserControl>
